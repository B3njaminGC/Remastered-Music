# ---------------------------------------------------------------------------
# Datos personales y credenciales (nunca deben entrar al repositorio)
# ---------------------------------------------------------------------------
**/*.keystore
**/*.jks
**/*.p12
**/*.pem
**/*.key
android/key.properties
android/local.properties
secrets.*
.env
.env.*

# Música, listas y capturas de prueba
*.mp3
*.m4a
*.flac
*.ogg
*.opus
*.wav
*.m3u
*.m3u8
/capturas/

# ---------------------------------------------------------------------------
# Compilación
# ---------------------------------------------------------------------------
build/
.dart_tool/
.packages
.pub/
.pub-cache/
.flutter-plugins
.flutter-plugins-dependencies
*.apk
*.aab

# Android (la carpeta la genera tools/ci/prepare_android.py)
android/.gradle/
android/gradlew
android/gradlew.bat
android/captures/
android/app/debug/
android/app/profile/
android/app/release/

# ---------------------------------------------------------------------------
# Lenguajes y herramientas
# ---------------------------------------------------------------------------
# Python (scripts de tools/ci/)
__pycache__/
*.py[cod]
.venv/
venv/

# ---------------------------------------------------------------------------
# Editores y sistemas operativos
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.iml
*.log
.DS_Store
Thumbs.db
desktop.ini
